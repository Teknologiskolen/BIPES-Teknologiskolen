# BIPES Production Environment Variables
# Copy this file to .env and update with your values

# The system always runs in full auth mode (PostgreSQL + login).
# Deploy on the VM with: sudo ./deploy.sh --domain <your-domain>  (or `make deploy-prod`).
# Both apply docker-compose.prod.yml for the 1 vCPU / 2 GB resource limits. A bare
# `docker compose up -d` loads the dev override (no limits) — not for production.
AUTH_MODE=full
COMPOSE_PROJECT_NAME=bipes

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
PASSWORD_PEPPER=change-this-to-a-random-secret-pepper

# Teacher accounts are created server-side (no self-registration):
#   docker compose exec web python scripts/add_teacher.py "name@school.dk" "Full Name"

# PostgreSQL (only needed in full auth mode)
POSTGRES_DB=bipes
# Must match the compose default (bipes_user); the healthcheck and backup scripts use it.
POSTGRES_USER=bipes_user
POSTGRES_PASSWORD=change-this-password

# Mosquitto MQTT
# MOSQUITTO_USERNAME/PASSWORD are server-side bridge credentials only.
# Device credentials are generated per user/device by Mosquitto Dynamic Security.
MOSQUITTO_USERNAME=bipes-server
MOSQUITTO_PASSWORD=change-this-password
MOSQUITTO_DYNSEC_ENABLED=true
MOSQUITTO_DYNSEC_ADMIN_USERNAME=admin
MOSQUITTO_DYNSEC_ADMIN_PASSWORD=change-this-dynsec-admin-password

# Production defaults for a 1 vCPU / 2 GB VM.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4

# Local backup retention. Keep an additional off-VM copy or provider snapshot.
BACKUP_RETENTION_DAYS=7

# How long to keep audit-log rows (auth_events: login attempts, IP, User-Agent) before
# the nightly cleanup purges them. Revoked/expired sessions are always purged nightly.
AUTH_EVENT_RETENTION_DAYS=90
