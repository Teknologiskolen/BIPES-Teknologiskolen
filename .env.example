# BIPES Production Environment Variables
# Copy this file to .env and update with your values

# Auth Mode: "full" (teacher+student+guest with login) or "guest" (guest-only, no login)
# Full mode:  docker compose --profile auth up -d
# Guest mode: docker compose up -d
AUTH_MODE=full

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
PASSWORD_PEPPER=change-this-to-a-random-secret-pepper

# Teacher registration gating (recommended for public deployments).
# - If set, anyone registering a teacher account at /register must supply this exact code.
# - If left empty, /register is open ONLY until the first teacher exists (bootstrap),
#   then it closes automatically. Set a code here to allow more teachers afterwards.
TEACHER_REGISTRATION_CODE=

# PostgreSQL (only needed in full auth mode)
POSTGRES_DB=bipes
POSTGRES_USER=tsdbuser
POSTGRES_PASSWORD=change-this-password

# Mosquitto MQTT
# MOSQUITTO_USERNAME/PASSWORD are server-side bridge credentials only.
# Device credentials are generated per user/device by Mosquitto Dynamic Security.
MOSQUITTO_USERNAME=bipes-server
MOSQUITTO_PASSWORD=change-this-password
MOSQUITTO_DYNSEC_ENABLED=true
MOSQUITTO_DYNSEC_ADMIN_USERNAME=admin
MOSQUITTO_DYNSEC_ADMIN_PASSWORD=change-this-dynsec-admin-password
