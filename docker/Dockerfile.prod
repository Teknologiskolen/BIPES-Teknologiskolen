FROM python:3.11-slim

WORKDIR /app

# Install only the runtime package needed by the application. mosquitto_ctrl
# (used to provision dynamic-security clients) ships in the mosquitto package.
RUN apt-get update && apt-get install -y \
    mosquitto \
    && rm -rf /var/lib/apt/lists/*

# Install pinned Python dependencies before copying the application so ordinary
# source changes keep this relatively expensive layer cached.
COPY requirements-prod.txt .
RUN pip install --no-cache-dir -r requirements-prod.txt

# Copy application
COPY . .

# Create logs directory
RUN mkdir -p /app/logs

# Run as a non-root user. The web container is the internet-facing application code
# (behind nginx) and the most likely RCE target; dropping root limits the blast radius of
# any code-exec or container-escape bug. gunicorn binds 5000 (unprivileged) and the app
# only reads /app and writes /app/logs plus the request-time generated assets under
# /app/static and /app/templates, so an unprivileged user that owns /app suffices.
RUN useradd --system --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 5000

# Always start with PostgreSQL + full authentication — there is no second
# (guest/sqlite) startup path.
CMD ["gunicorn", "--config", "/app/docker/gunicorn_config.py", "app:create_app(\"postgresql\")"]
