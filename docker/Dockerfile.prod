FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy application
COPY . .

# Install Python dependencies
RUN pip install --no-cache-dir Flask gunicorn flask-mqtt paho-mqtt psycopg psycopg-binary

# Create logs directory
RUN mkdir -p /app/logs

# Expose port
EXPOSE 5000

# Run gunicorn - database selection based on AUTH_MODE env var
# Full mode (AUTH_MODE=full): uses PostgreSQL for auth + data
# Guest mode (AUTH_MODE=guest): uses SQLite for MQTT data only, no auth
CMD ["sh", "-c", "if [ \"$AUTH_MODE\" = 'guest' ]; then exec gunicorn --config /app/docker/gunicorn_config.py 'app:create_app(\"sqlite\")'; else exec gunicorn --config /app/docker/gunicorn_config.py 'app:create_app(\"postgresql\")'; fi"]
