# BIPES Production Environment Variables
# Copy this file to .env and update with your values

# Auth Mode: "full" (teacher+student+guest with login) or "guest" (guest-only, no login)
# Full mode:  docker compose --profile auth up -d
# Guest mode: docker compose up -d
AUTH_MODE=guest

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# PostgreSQL
POSTGRES_DB=bipes
POSTGRES_USER=tsdbuser
POSTGRES_PASSWORD=change-this-password

# Mosquitto MQTT
MOSQUITTO_PASSWORD=change-this-password
