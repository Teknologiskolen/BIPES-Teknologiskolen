# BIPES Production Environment Variables
# Copy this file to .env and update with your values

# Auth Mode: "full" (teacher+student+guest with login) or "guest" (guest-only, no login)
# Full mode:  docker compose --profile auth up -d
# Guest mode: docker compose up -d
AUTH_MODE=full

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# PostgreSQL
POSTGRES_DB=bipes
POSTGRES_USER=tsdbuser
POSTGRES_PASSWORD=change-this-password

# Mosquitto MQTT
MOSQUITTO_USERNAME=bipes-server
MOSQUITTO_PASSWORD=change-this-password
MOSQUITTO_DYNSEC_ENABLED=true
MOSQUITTO_DYNSEC_ADMIN_USERNAME=admin
MOSQUITTO_DYNSEC_ADMIN_PASSWORD=change-this-dynsec-admin-password

# Pepper Password for hashing (openssl rand -base64 32)
PASSWORD_PEPPER=b3u52PXzCKRakSV4BlNpvk/XbVN8YoD9b1k4fI6G5cA
