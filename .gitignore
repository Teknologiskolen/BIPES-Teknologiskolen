venv/
.venv/
.env
_temp/
__pycache__/

package.json
package-lock.json
node_modules/

# App-generated bundles stay ignored (Flask regenerates them via concat routes).
*.umd.js
# ...but the third-party vendored libraries (fetched by `make umd-deps/unpkg/blockly`)
# MUST be committed: the Docker build does `COPY . .` and does NOT fetch them, so a
# fresh clone otherwise ships without Blockly etc. ("Blockly is not defined").
!static/libs/*.umd.js
!static/page/blocks/blocks/logic.umd.js
*.temp.js
*.zip
*.db
*.swp
*.ini

static/page/blocks/msg
# blockly media (icons) — vendored by `make blockly`; commit it (build doesn't fetch).

/ide.html
BIPES

app.pyc

server/*.txt
static/import/*

licenses/
docs/_build

# Runtime / generated artifacts (regenerated by the app or operator; never commit).
backups/
# DB dumps / security-state backups — NEVER commit: they hold password hashes, MQTT
# credentials and student PII. Belt-and-suspenders for a backup copied outside backups/
# (e.g. scp'd into the repo root). Does not match docker/init-db.sql (that's .sql, kept).
*.sql.gz
*.dump
dynamic-security*.json
logs/
static/style.css

docker/*
!docker/Dockerfile
!docker/Dockerfile.prod
!docker/docker-compose.yml
!docker/nginx.conf
!docker/gunicorn_config.py
!docker/init-db.sql
!docker/mosquitto.conf
!docker/generate-ssl.sh
!docker/backup-db.sh
!docker/cleanup-db.sh
