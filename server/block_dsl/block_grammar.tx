BlockdefFile:
    'module' name=/[_a-zA-Z]\w*/
    imports*=ImportDecl
    ('url' url=STRING)?
    categories*=CategoryDef
;

ImportDecl:
    'import' name=STRING
;

CategoryDef:
    'category' name=STRING ('color' '=' color=INT)?
    '{' entries*=CategoryEntry '}'
;

CategoryEntry: ClassDef | FunctionBlock;

ClassDef:
    'class' class_name=/[_a-zA-Z]\w*/
    'as' instance_mode=/singleton|multiple/
    ('named' instance_name=STRING)?
    ('ref' method_ref=/key_input|object_input/)?
    '{' blocks*=FunctionBlock '}'
;

FunctionBlock:
    'block' fn_name=/[_a-zA-Z]\w*/
    ('label'   '=' label=STRING)?
    ('kind'    '=' kind=/value|statement|hat/)?
    ('inline'  '=' inline=InlineFlag)?
    ('tooltip' '=' tooltip=STRING)?
    ('{' params*=ParamDef '}')?
;

InlineFlag:
    value=BOOL
;

ParamDef:
    'param' name=/[_a-zA-Z]\w*/
    ('type'    '=' type_name=/Number|String|Boolean|Any/)?
    ('default' '=' default=ParamDefault)?
    (is_pin?='pin')?
    ('options' '[' options+=DropdownOpt[','] ']')?
;

ParamDefault:
    SeqDefault | BoolDefault | FloatDefault | IntDefault | StrDefault
;

SeqDefault:
    '[' items*=ScalarDefault[','] ']'
;

ScalarDefault:
    BoolDefault | FloatDefault | IntDefault | StrDefault
;

// NB: explicit regexes, NOT the textX BOOL/FLOAT base types. BOOL matches 0/1 (so
// `default=0` would parse as False) and FLOAT matches plain integers (so `default=8`
// would parse as 8.0 -> emitted "8.0" into a pin dropdown -> broken). Here a bool is
// ONLY true/false, a float REQUIRES a decimal point, and a plain integer stays an int.
// The matched value is a string; blockdef_parser._scalar_to_python casts it by rule.
BoolDefault:  val=/true|false/;
FloatDefault: val=/[-+]?\d+\.\d+([eE][-+]?\d+)?/;
IntDefault:   val=/[-+]?\d+/;
StrDefault:   val=STRING;

DropdownOpt:
    '(' label=STRING ',' val=STRING ')'
;

