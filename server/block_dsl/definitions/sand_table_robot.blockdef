// Block definitions for the sand-drawing SCARA robot (sand_table_robot.py).
// The library .py is untouched; this .blockdef is the single source of truth.

module sand_table_robot
import "sand_table_robot"
url "https://github.com/bipes"

category "Sand Drawing Machine" color=30 {

    class SandTableRobot as singleton named "sand_table_robot" {

        // Only the two motor pin-arrays and the two sensor pins are exposed; the
        // rest (arm lengths, steps/rev, backlash, homing dirs, speed) use the
        // library's defaults. Edit the .py defaults to change them.
        block __init__ tooltip="Create the sand-table SCARA robot: the two motor pin-arrays and the two homing-sensor pins." {
            param motor1_pins type=Any default=[21,20,19,18]
            param motor2_pins type=Any default=[17,16,15,14]
            param sensor_shoulder_pin type=Number default=22 pin
            param sensor_elbow_pin    type=Number default=1  pin
        }

        block home tooltip="Home the robot to its reference position."
        block off  tooltip="Power off both stepper motors."

        // Low-level teaching blocks: move one stepper, read one homing sensor.
        block step_motor label="Drej motor {motor} {direction} {steps} trin, fart {speed} ms" tooltip="Drej én stepmotor et antal trin. 4096 trin = en hel omgang. Fart = ms pr. trin (større = langsommere)." {
            param motor type=Number options[("1 (skulder)","1"),("2 (albue)","2")]
            param direction options[("fremad","f"),("tilbage","r")]
            param steps type=Number default=500
            param speed type=Number default=3
        }

        block move_line tooltip="Move in a straight line to (x, y)." {
            param target_x type=Number default=0
            param target_y type=Number default=0
            param segments type=Number default=500
            param speed    type=Number default=2
        }
        block move_arc tooltip="Draw an arc around a centre point." {
            param center_x type=Number default=0
            param center_y type=Number default=0
            param radius type=Number default=10
            param start_angle type=Number default=0
            param end_angle type=Number default=180
            param segments type=Number default=50
            param speed type=Number default=2
        }
        block draw_spiral tooltip="Draw a spiral." {
            param max_radius type=Number default=30
            param vindinger type=Number default=10
            param segments_pr_omgang type=Number default=60
            param speed type=Number default=2
        }
        block draw_flower tooltip="Draw a flower pattern." {
            param max_radius type=Number default=30
            param petals type=Number default=5
            param speed type=Number default=2
        }
        block run_gcode_text tooltip="Run G-code from a text string." {
            param gcode_text type=String
            param segments type=Number default=40
            param draw_speed_ms type=Number default=2
            param travel_speed_ms type=Number default=2
            param reset_modal type=Boolean default=true
        }
        block run_gcode_file tooltip="Run G-code from a file on the device." {
            param path type=String default="/drawing.gcode"
            param segments type=Number default=40
            param draw_speed_ms type=Number default=2
            param travel_speed_ms type=Number default=2
            param reset_modal type=Boolean default=true
        }
    }
}
